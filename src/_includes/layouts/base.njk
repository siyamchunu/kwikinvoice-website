<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or 'KwikInvoice - Professional invoicing for small businesses in South Africa' }}">
    <meta name="keywords" content="invoice, invoicing, small business, south africa, kwikinvoice">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://kwikinvoice.loggedon.co.za{{ page.url }}">
    <meta property="og:title" content="{{ title or 'KwikInvoice' }}">
    <meta property="og:description" content="{{ description or 'Professional invoicing for small businesses' }}">
    
    <title>{{ title or 'KwikInvoice' }}{{ ' | KwikInvoice' if title }}</title>
    
    <link rel="stylesheet" href="/public/css/styles.css">
    <link rel="icon" href="/public/images/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    {% include "partials/header.njk" %}
    
    <main>
        {{ content | safe }}
    </main>
    
    {% include "partials/footer.njk" %}
</body>
</html>
