---
layout: layouts/base.njk
---

<article class="blog-post">
    <div class="container">
        <header class="post-header">
            <a href="/blog" class="back-link">← Back to Blog</a>
            {% if image %}
            <div class="post-hero-image">
                <img src="{{ image }}" alt="{{ imageAlt | default(title) }}" loading="eager" width="1200" height="630">
                {% if imageCredit %}
                <p class="image-credit">{{ imageCredit | safe }}</p>
                {% endif %}
            </div>
            {% endif %}
            <h1>{{ title }}</h1>
            <div class="post-meta">
                <time datetime="{{ date }}">{{ date | readableDate }}</time>
                {% if category %}
                <span class="post-category category-{{ category | lower }}">{{ category }}</span>
                {% endif %}
            </div>
        </header>
        
        <div class="post-content">
            {{ content | safe }}
        </div>
    </div>
</article>
